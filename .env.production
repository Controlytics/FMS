# ===========================================
# DigiLog Production Environment Configuration
# ===========================================

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://digilog_user:YOUR_SECURE_PASSWORD@localhost:5432/digilog_db?schema=public"

# JWT Configuration
JWT_SECRET="GENERATE_A_SECURE_64_CHAR_RANDOM_STRING_HERE"
JWT_EXPIRES_IN="8h"

# Server Configuration
NODE_ENV="production"
API_PORT=3000
API_HOST="0.0.0.0"

# CORS Configuration (your EC2 public IP or domain)
CORS_ORIGIN="http://YOUR_EC2_PUBLIC_IP"

# Upload Configuration
UPLOAD_DIR="/home/ubuntu/ec2complete/uploads"
MAX_FILE_SIZE="5242880"
