# ===========================================
# DigiLog Environment Variables
# Copy to .env and update values for your instance
# ===========================================

# ─── PostgreSQL (Prisma) ──────────────────────────────────
DATABASE_URL=postgresql://digilog:digilog123@localhost:5432/digilog_db?schema=public

# ─── TimescaleDB ─────────────────────────────────────────
TSDB_HOST=localhost
TSDB_PORT=5432
TSDB_DATABASE=digilog_tsdb
TSDB_USER=digilog
TSDB_PASSWORD=digilog123
TSDB_POOL_MAX=20

# ─── MQTT (EMQX) ────────────────────────────────────────
MQTT_ENABLED=true
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_TLS_PORT=8883
MQTT_BROKER_WS_PORT=8083
MQTT_BROKER_WSS_PORT=8084
MQTT_AUTH_CALLBACK_URL=http://localhost:3000/api/internal/mqtt
EMQX_ADMIN_PASSWORD=change-this-emqx-admin-password

# ─── Redis (BullMQ + Pub/Sub) ────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── SMTP (optional - for email notifications) ──────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── UNS (topic prefix) ──────────────────────────────────
UNS_ROOT_PREFIX=digilog/v1
UNS_VERSION=v1

# ─── JWT Configuration ───────────────────────────────────
# Generate secrets: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=change-this-to-a-secure-random-string
VERIFICATION_TOKEN_SECRET=change-this-to-another-secure-random-string
JWT_EXPIRES_IN=8h

# ─── Server Configuration ────────────────────────────────
NODE_ENV=production
API_PORT=3000

# ─── CORS Configuration ──────────────────────────────────
# Set to your server IP or domain
CORS_ORIGIN=http://YOUR_SERVER_IP
ALLOWED_ORIGINS=http://YOUR_SERVER_IP,http://localhost:5173

# ─── Upload Configuration ────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
