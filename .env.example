# ===========================================
# DigiLog Environment Variables
# Copy to .env and update values for your instance
# ===========================================

# ─── PostgreSQL (Prisma) ──────────────────────────────────
DATABASE_URL=postgresql://digilog:CHANGE_ME@localhost:5432/digilog_db?schema=public

# ─── TimescaleDB ─────────────────────────────────────────
TSDB_HOST=localhost
TSDB_PORT=5432
TSDB_DATABASE=digilog_tsdb
TSDB_USER=digilog
TSDB_PASSWORD=CHANGE_ME
TSDB_POOL_MAX=20

# ─── MQTT (Mosquitto) ───────────────────────────────────
# Phase 1 of windows-friendly-rewrite swapped EMQX → Mosquitto 2.0.
# Optional unless testing MQTT ingest. Dynsec auth via POST /api/internal/mqtt/refresh-acl.
MQTT_ENABLED=true
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_AUTH_CALLBACK_URL=http://localhost:3000/api/internal/mqtt

# Redis was fully retired (Phase 2 → graphile-worker queue, Phase 4 → in-process
# bus + Map TTL cache). No REDIS_* / ioredis dependency exists anymore.

# ─── SMTP (optional - for email notifications) ──────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── UNS (topic prefix) ──────────────────────────────────
UNS_ROOT_PREFIX=digilog/v1
UNS_VERSION=v1

# ─── JWT Configuration ───────────────────────────────────
# Generate secrets: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# Both REQUIRED in production; API exits fatally if missing or <32 chars.
JWT_SECRET=change-this-to-a-secure-random-string
VERIFICATION_TOKEN_SECRET=change-this-to-another-secure-random-string
# Signs offline-replay envelopes. REQUIRED in production/staging (server refuses
# to boot without it); dev auto-derives from JWT_SECRET with a warning. 32+ chars.
OFFLINE_REPLAY_SECRET=change-this-to-a-persistent-32-plus-char-random-string
# Audit 2026-05-29 S-8: default JWT TTL reduced from 8h → 1h.
# Override via JWT_EXPIRY_HOURS (integer hours, clamped at signToken).
JWT_EXPIRES_IN=1h

# ─── Server Configuration ────────────────────────────────
NODE_ENV=production
API_PORT=3000

# ─── CORS Configuration ──────────────────────────────────
# Set to your server IP or domain
CORS_ORIGIN=http://YOUR_SERVER_IP
ALLOWED_ORIGINS=http://YOUR_SERVER_IP,http://localhost:5173

# ─── Upload Configuration ────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
