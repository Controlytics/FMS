# ===========================================
# DigiLog Environment Variables
# Copy to .env and fill in values
# ===========================================

# ─── PostgreSQL (Prisma) ──────────────────────────────────
DATABASE_URL=postgresql://digilog_app:digilog_secret@localhost:5432/digilog?schema=public

# ─── TimescaleDB (Separate Instance) ─────────────────────
TSDB_HOST=localhost
TSDB_PORT=5433
TSDB_DATABASE=digilog_tsdb
TSDB_USER=digilog_app
TSDB_PASSWORD=tsdb_secret
TSDB_POOL_MAX=20

# ─── MQTT (External EMQX) ────────────────────────────────
MQTT_ENABLED=true
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_TLS_PORT=8883
MQTT_BROKER_WS_PORT=8083
MQTT_BROKER_WSS_PORT=8084
MQTT_AUTH_CALLBACK_URL=http://localhost:3000/api/internal/mqtt
EMQX_ADMIN_PASSWORD=emqx_admin_secret

# ─── Redis (BullMQ + Pub/Sub) ────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── SMTP (connection only) ──────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── UNS (topic prefix) ──────────────────────────────────
UNS_ROOT_PREFIX=digilog/v1
UNS_VERSION=v1

# ─── JWT Configuration ───────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string
VERIFICATION_TOKEN_SECRET=change-this-to-another-secure-random-string
JWT_EXPIRES_IN=8h

# ─── Server Configuration ────────────────────────────────
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0

# ─── CORS Configuration ──────────────────────────────────
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:3000

# ─── Upload Configuration ────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
