# Windows-friendly migration flags (Phase 1 + Phase 3 of windows-friendly-rewrite plan)
# Phase 2 (USE_PG_QUEUE) was completed in Task 2.10 — graphile-worker is now
# the sole queue backend, no flag needed.
USE_MOSQUITTO=false   # set true to use Mosquitto instead of EMQX
USE_EDGE_PDF=false    # set true to use Edge headless instead of bundled Chromium

# Mosquitto MQTT broker (Phase 1 of windows-friendly-rewrite, behind USE_MOSQUITTO=true)
# Required when USE_MOSQUITTO=true; without these the API's MQTT subscription
# is rejected and /refresh-acl returns 500.
MOSQUITTO_ADMIN_PASSWORD=change-this-to-a-random-12-plus-char-string
MOSQUITTO_REFRESH_TOKEN=change-this-to-a-random-bearer-secret
MOSQUITTO_DYNSEC_PATH=./mosquitto/dynamic-security.json
