# Windows-friendly migration flags (Phases 1, 2, 3 of windows-friendly-rewrite)
# Phase 2 (USE_PG_QUEUE) was completed in Task 2.10 — graphile-worker is now
# the sole queue backend, no flag needed.
# Phase 3 (USE_EDGE_PDF) retired — pdf-renderer.ts always uses puppeteer-core
# + detectEdgePath() now; if you need a different browser, set
# PUPPETEER_EXECUTABLE_PATH below.
USE_MOSQUITTO=true    # leave true unless you need to fall back to legacy EMQX
                      # webhook auth (slated for deletion in Phase 4)

# Mosquitto MQTT broker (Phase 1 of windows-friendly-rewrite, behind USE_MOSQUITTO=true)
# Required when USE_MOSQUITTO=true; without these the API's MQTT subscription
# is rejected and /refresh-acl returns 500.
MOSQUITTO_ADMIN_PASSWORD=CHANGE_ME_RANDOM_12_PLUS_CHAR_STRING
MOSQUITTO_REFRESH_TOKEN=CHANGE_ME_RANDOM_BEARER_SECRET
MOSQUITTO_DYNSEC_PATH=./mosquitto/dynamic-security.json
# After every POST /api/internal/mqtt/refresh-acl, copy the regenerated
# dynsec into C:\Program Files\mosquitto\ and Restart-Service mosquitto
# (the broker reads dynsec at startup; no SIGUSR1 reload on Windows).

# Offline-replay grant secret (REQUIRED for stable offline sync)
# Signs the x-offline-replay-token HMAC used by sync-engine.ts to replay
# queued cleaning ops. If unset, lib/offline-replay-token.ts logs a WARNING
# and derives a per-PROCESS random secret. Every API restart then rotates
# the secret, which invalidates every outstanding grant — operators see
# queued ops sit forever with no UI signal (sync-engine pre-flight check
# at sync-engine.ts:396-410 bails). Set to a stable 32+ char string so
# grants survive restarts. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
OFFLINE_REPLAY_SECRET=CHANGE_ME_TO_A_PERSISTENT_32_PLUS_CHAR_RANDOM_STRING

# PDF rendering (Phase 3 of windows-friendly-rewrite — puppeteer-core + Edge)
# Optional: explicit browser executable path. detectEdgePath() probes
# Edge → Chrome on Windows, chromium → google-chrome on Linux,
# .app bundles on macOS automatically. Set this only to override.
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
