{
  "name": "@digilog/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "lint": "tsc --noEmit",
    "test": "vitest run --pool=forks --poolOptions.forks.singleFork=true",
    "test:e2e": "vitest run --pool=forks --poolOptions.forks.singleFork=true --testPathPattern=e2e",
    "lint:js": "eslint \"src/**/*.ts\" --max-warnings 10000",
    "test:coverage": "vitest run --pool=forks --poolOptions.forks.singleFork=true --coverage"
  },
  "dependencies": {
    "@digilog/queue": "*",
    "@digilog/shared": "*",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^6.3.0",
    "adm-zip": "^0.6.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.10.0",
    "fastify-plugin": "^5.0.0",
    "jose": "^6.0.0",
    "ldapts": "^8.1.7",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "prisma": "^6.3.0",
    "sanitize-html": "^2.17.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.4",
    "@eslint/js": "^9.39.4",
    "typescript-eslint": "^8.59.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
