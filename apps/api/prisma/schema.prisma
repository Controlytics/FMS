  severity  String  @db.VarChar(20) // CRITICAL | MAJOR | MINOR | WARNING | INFO
  status    String  @default("ACTIVE") @db.VarChar(20) // ACTIVE | ACKNOWLEDGED | CLEARED | MANUALLY_CLEARED
  unsPath   String  @map("uns_path")

  // Creation
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdByRuleChain String?  @map("created_by_rule_chain") @db.Uuid
  triggerDetails     Json?    @map("trigger_details") @db.JsonB

  // Acknowledgment
  acknowledged   Boolean   @default(false)
  acknowledgedBy String?   @map("acknowledged_by") @db.VarChar(50)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz
  ackRemarks     String?   @map("ack_remarks")
  ackSignatureId String?   @map("ack_signature_id") @db.Uuid

