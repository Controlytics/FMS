// ─── Notification Rules ───────────────────────────────────────────────
model NotificationRule {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String                  @db.VarChar(200)
  description String?                 @db.VarChar(500)
  eventType   NotificationEventType   @map("event_type")
  eventTypes  NotificationEventType[] @default([]) @map("event_types")

  // Filtering conditions (JSONB): e.g. {"severity": ["CRITICAL","MAJOR"]}
  conditions Json @default("{}") @db.JsonB

  // Channels
  emailEnabled Boolean @default(false) @map("email_enabled")
  smsEnabled   Boolean @default(false) @map("sms_enabled")
  inAppEnabled Boolean @default(true) @map("in_app_enabled")

  // Template references
  emailTemplateId String? @map("email_template_id") @db.Uuid
  smsTemplateId   String? @map("sms_template_id") @db.Uuid

  // Throttling
  cooldownMinutes Int @default(0) @map("cooldown_minutes")

  isActive  Boolean  @default(true) @map("is_active")
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.VarChar(50)

  recipients NotificationRuleRecipient[]

  @@index([eventType])
  @@index([isActive])
  @@index([isActive, priority(sort: Desc)])
  @@map("notification_rules")
}

model NotificationRuleRecipient {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId        String  @map("rule_id") @db.Uuid
  recipientType String  @map("recipient_type") @db.VarChar(20) // ROLE | GROUP | USER
  roleValue     String? @map("role_value") @db.VarChar(50)
  groupId       String? @map("group_id") @db.Uuid
  userId        String? @map("user_id") @db.Uuid

  rule  NotificationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  group UserGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([ruleId])
  @@map("notification_rule_recipients")
}

// ─── Phase 2: Filter Management System ─────────────────────

enum PmScheduleStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("pm_schedule_status")
}

enum PmEntryApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("pm_entry_approval_status")
}

enum CleaningProfileStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("cleaning_profile_status")
}

enum PmExecutionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  MISSED

  @@map("pm_execution_status")
}

enum FilterSetLabel {
  SET_A
  SET_B

  @@map("filter_set_label")
}

enum PipelineFlowMode {
  STRICT
  BYPASS_ENABLED

  @@map("pipeline_flow_mode")
}

enum PipelineNodeType {
  STAGE
  START
  END
  CHECKLIST
  REMARKS
  DURATION_INTERLOCK
  PARAM_CAPTURE
  CUSTOM_SCRIPT
  APPROVAL
  EQUIPMENT_LINK

  @@map("pipeline_node_type")
}

enum CleaningCycleStatus {
  IN_PROGRESS
  COMPLETED
  TERMINATED

  @@map("cleaning_cycle_status")
}

enum FilterEventType {
  STATE_TRANSITION
  PARAMETER_CAPTURE
  CHECKLIST_COMPLETED
  BYPASS_DEVIATION
  EQUIPMENT_LINKED
  REMARK_ADDED
  APPROVAL_GRANTED
  SCRIPT_EXECUTED
  CYCLE_STARTED
  CYCLE_COMPLETED
  CYCLE_TERMINATED

  @@map("filter_event_type")
}

enum BlockRestriction {
  OWN_BLOCK_ONLY
  ANY_BLOCK
  SPECIFIC_BLOCKS

  @@map("block_restriction")
}

model PmSchedule {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityId  String           @map("entity_id") @db.Uuid
  year      Int
  version   Int              @default(1)
  status    PmScheduleStatus @default(DRAFT)
  createdBy String           @map("created_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  entries        PmScheduleEntry[]
  filterProfiles FilterProfile[]

  @@unique([entityId, year, version])
  @@index([entityId, status])
  @@index([year])
  @@map("pm_schedules")
}

model PmScheduleEntry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId    String   @map("schedule_id") @db.Uuid
  month         Int
  plannedDate   DateTime @map("planned_date") @db.Date
  toleranceDays Int      @default(0) @map("tolerance_days")
  windowStart   DateTime @map("window_start") @db.Date
  windowEnd     DateTime @map("window_end") @db.Date
  notes         String?

  // QA approval workflow
  approvalStatus  PmEntryApprovalStatus @default(PENDING) @map("approval_status")
  approvalRemarks String?               @map("approval_remarks")
  approvedBy      String?               @map("approved_by") @db.Uuid
  approvedByName  String?               @map("approved_by_name") @db.VarChar(255)
  approvedAt      DateTime?             @map("approved_at") @db.Timestamptz
  submittedBy     String?               @map("submitted_by") @db.Uuid
  submittedByName String?               @map("submitted_by_name") @db.VarChar(255)

  // Pending edit (approved value stays active while edit awaits QA)
  pendingPlannedDate   DateTime? @map("pending_planned_date") @db.Date
  pendingToleranceDays Int?      @map("pending_tolerance_days")
  pendingEditBy        String?   @map("pending_edit_by") @db.Uuid
  pendingEditAt        DateTime? @map("pending_edit_at") @db.Timestamptz

  schedule   PmSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  executions PmExecution[]

  @@unique([scheduleId, month])
  @@index([scheduleId])
  @@index([windowStart, windowEnd])
  @@index([approvalStatus])
  @@map("pm_schedule_entries")
}

model PmExecution {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleEntryId String            @map("schedule_entry_id") @db.Uuid
  entityId        String            @map("entity_id") @db.Uuid
  status          PmExecutionStatus @default(SCHEDULED)
  startedAt       DateTime?         @map("started_at") @db.Timestamptz
  completedAt     DateTime?         @map("completed_at") @db.Timestamptz
  performedBy     String?           @map("performed_by") @db.Uuid
  isWithinWindow  Boolean           @default(true) @map("is_within_window")
  filterSet       FilterSetLabel?   @map("filter_set")
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  scheduleEntry PmScheduleEntry @relation(fields: [scheduleEntryId], references: [id])

  @@index([entityId, status])
  @@index([scheduleEntryId])
  @@map("pm_executions")
}

model FilterCleaningProfile {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineageId            String                @map("lineage_id") @db.Uuid
  name                 String                @db.VarChar(255)
  description          String?
  flowMode             PipelineFlowMode      @default(STRICT) @map("flow_mode")
  alarmOnForwardSkip   Boolean               @default(true) @map("alarm_on_forward_skip")
  alarmOnBackwardJump  Boolean               @default(true) @map("alarm_on_backward_jump")
  alarmOnOutOfSequence Boolean               @default(true) @map("alarm_on_out_of_sequence")
  cleaningReasons      Json?                 @map("cleaning_reasons") @db.JsonB
  version              Int                   @default(1)
  status               CleaningProfileStatus @default(DRAFT)
  createdBy            String                @map("created_by") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  stages         FilterPipelineStage[]
  connections    FilterPipelineConnection[]
  cleaningCycles CleaningCycle[]
  filterProfiles FilterProfile[]

  @@unique([lineageId, version])
  @@index([status])
  @@index([lineageId])
  @@map("filter_cleaning_profiles")
}

model FilterPipelineStage {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId     String           @map("profile_id") @db.Uuid
  stateKey      String?          @map("state_key") @db.VarChar(100)
  nodeType      PipelineNodeType @map("node_type")
  configuration Json             @default("{}") @db.JsonB
  positionX     Float            @default(0) @map("position_x")
  positionY     Float            @default(0) @map("position_y")
  sortOrder     Int              @default(0) @map("sort_order")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz

  profile   FilterCleaningProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fromConns FilterPipelineConnection[] @relation("FromStage")
  toConns   FilterPipelineConnection[] @relation("ToStage")

  @@index([profileId, sortOrder])
  @@map("filter_pipeline_stages")
}

model FilterPipelineConnection {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String  @map("profile_id") @db.Uuid
  fromStageId String  @map("from_stage_id") @db.Uuid
  toStageId   String  @map("to_stage_id") @db.Uuid
  label       String? @default("Next") @db.VarChar(100)

  profile   FilterCleaningProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fromStage FilterPipelineStage   @relation("FromStage", fields: [fromStageId], references: [id], onDelete: Cascade)
  toStage   FilterPipelineStage   @relation("ToStage", fields: [toStageId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([fromStageId])
  @@map("filter_pipeline_connections")
}

model FilterProfile {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String           @db.VarChar(255)
  description         String?
  cleaningProfileId   String           @map("cleaning_profile_id") @db.Uuid
  defaultPmScheduleId String?          @map("default_pm_schedule_id") @db.Uuid
  blockRestriction    BlockRestriction @default(OWN_BLOCK_ONLY) @map("block_restriction")
  allowedBlocks       Json?            @map("allowed_blocks") @db.JsonB
  maxCleaningCycles   Int?             @map("max_cleaning_cycles")
  isActive            Boolean          @default(true) @map("is_active")
  // Monotonic version counter — bumped on every mutation. Snapshot-then-bump
  // pattern (Phase A.3): the OUTGOING state is frozen into FilterProfileVersion
  // before the live row is updated, so audit replay can reconstruct the exact
  // mapping that was active at any historical moment.
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  cleaningProfile     FilterCleaningProfile?            @relation(fields: [cleaningProfileId], references: [id])
  pmSchedule          PmSchedule?                       @relation(fields: [defaultPmScheduleId], references: [id])
  filterDetails       FilterDetails[]                   @relation("FilterProfileFilterDetails")
  versions            FilterProfileVersion[]
  // Step 4 (2026-05-02): replaces the prior `applicableTemplates Json` array
  // on this row. Reads should `include: { applicableTemplates: { select: {
  // templateId: true } } }` and flatten so the API response shape stays
  // `applicableTemplates: string[]` and the FE doesn't need to change.
  applicableTemplates FilterProfileApplicableTemplate[]

  @@index([isActive])
  @@map("filter_profiles")
}

// Step 4 (2026-05-02): join table replacing FilterProfile.applicableTemplates
// JSONB array. Both FKs cascade-delete so a vanishing AssetTemplate or
// FilterProfile takes its bindings with it — no more dangling UUIDs in JSON.
// Server-side guard in template.service blocks AssetTemplate delete with
// 409 IN_USE if any FilterProfile still binds it; the cascade is the safety
// net, not the operator-visible path.
model FilterProfileApplicableTemplate {
  profileId  String   @map("profile_id") @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  profile  FilterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  template AssetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([profileId, templateId])
  @@index([templateId])
  @@map("filter_profile_applicable_templates")
}

// Immutable historical snapshot of a FilterProfile at a specific version.
// Written BEFORE every mutation to the live profile (snapshot-then-bump, Phase A.3).
// FilterProfile drift cannot affect in-flight cycles because cycles already
// pin `cleaning_cycles.profileId` to a specific FilterCleaningProfile row at
// start, so no cycle-side pin map is needed here — versions exist purely for
// audit replay and admin history.
model FilterProfileVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId     String   @map("profile_id") @db.Uuid
  versionNumber Int      @map("version_number")
  // Full snapshot of the live FilterProfile row: { name, description, cleaningProfileId,
  // applicableTemplates, defaultPmScheduleId, blockRestriction, allowedBlocks,
  // maxCleaningCycles, isActive }.
  snapshot      Json     @db.JsonB
  changeNotes   String?  @map("change_notes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String?  @map("created_by") @db.Uuid

  profile FilterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, versionNumber])
  @@index([profileId])
  @@map("filter_profile_versions")
}

model CleaningCycle {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleCode             String              @unique @map("cycle_code") @db.VarChar(100)
  filterId              String              @map("filter_id") @db.Uuid
  ahuId                 String?             @map("ahu_id") @db.Uuid
  profileId             String              @map("profile_id") @db.Uuid
  profileVersion        Int                 @map("profile_version")
  sequenceNumber        Int                 @map("sequence_number")
  status                CleaningCycleStatus @default(IN_PROGRESS)
  startedAt             DateTime            @default(now()) @map("started_at") @db.Timestamptz
  completedAt           DateTime?           @map("completed_at") @db.Timestamptz
  terminatedAt          DateTime?           @map("terminated_at") @db.Timestamptz
  terminationReason     String?             @map("termination_reason")
  cleaningAreaId        String?             @map("cleaning_area_id") @db.Uuid
  pmExecutionId         String?             @map("pm_execution_id") @db.Uuid
  cleaningReasonKey     String              @map("cleaning_reason_key") @db.VarChar(100)
  cleaningReasonLabel   String              @map("cleaning_reason_label") @db.VarChar(255)
  cleaningJustification String?             @map("cleaning_justification")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  equipmentGroupId         String? @map("equipment_group_id") @db.Uuid
  // P1 (2026-05-02): pins the EquipmentGroup version in effect when this cycle
  // bound the group. Set at start-cycle (or at the first auto-bind, whichever
  // happens first). Reading validation reads operating-range from the pinned
  // EquipmentGroupVersion snapshot, NOT the live group, so admin edits to
  // ranges mid-cycle don't reach the in-flight cycle. Nullable so legacy
  // cycles + cycles that never bound a group fall back to the live row
  // (backwards compatible). Slice B (next APK) will add an
  // `expectedGroupVersion` field on submit-readings + 409 SCHEMA_DRIFT
  // self-heal flow on the tablet — see future/offline-version-sync-contract.md.
  equipmentGroupVersionPin Int?    @map("equipment_group_version_pin")

  // Dryer timing — tracks the dryer duration and start time for DRY_IN stage
  dryerDurationMinutes   Int?      @map("dryer_duration_minutes")
  dryerStartedAt         DateTime? @map("dryer_started_at") @db.Timestamptz
  dryerReadingsSubmitted Boolean   @default(false) @map("dryer_readings_submitted")

  // Phase A.1: pinned ChecklistProfile versions at cycle start.
  // Shape: { [checklistProfileId: string]: versionNumber: int }
  // All checklist resolution during this cycle reads through these pins,
  // so admin edits to a profile mid-cycle do NOT change the questions or
  // required-flags the operator sees. Empty {} for legacy cycles started
  // before this column existed (fallback to live profile).
  checklistVersionPins Json @default("{}") @map("checklist_version_pins") @db.JsonB

  events              FilterEvent[]
  equipmentGroup      EquipmentGroup?        @relation(fields: [equipmentGroupId], references: [id])
  profile             FilterCleaningProfile? @relation(fields: [profileId], references: [id])
  activeFilterDetails FilterDetails[]        @relation("CurrentCycleFilterDetails")
  // Phase 5b.5 invariant (DB-side, not Prisma-expressible): at most ONE
  // IN_PROGRESS cycle per filter, enforced by partial unique index applied
  // via apps/api/prisma/sql/invariants.sql after every db push.

  @@index([filterId, status])
  @@index([ahuId, status])
  @@index([status])
  @@index([startedAt])
  @@index([cleaningReasonKey])
  @@index([pmExecutionId])
  @@index([filterId, status, startedAt(sort: Desc)])
  @@map("cleaning_cycles")
}

model FilterEvent {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filterId          String          @map("filter_id") @db.Uuid
  cycleId           String?         @map("cycle_id") @db.Uuid
  eventType         FilterEventType @map("event_type")
  fromState         String?         @map("from_state") @db.VarChar(100)
  toState           String?         @map("to_state") @db.VarChar(100)
  performedBy       String          @map("performed_by") @db.Uuid
  performedAt       DateTime        @default(now()) @map("performed_at") @db.Timestamptz
  cleaningAreaId    String?         @map("cleaning_area_id") @db.Uuid
  equipmentId       String?         @map("equipment_id") @db.Uuid
  blockId           String?         @map("block_id") @db.Uuid
  attributes        Json            @default("{}") @db.JsonB
  telemetrySnapshot Json            @default("{}") @map("telemetry_snapshot") @db.JsonB
  remarks           String?
  deviationDetails  Json?           @map("deviation_details") @db.JsonB
  checksum          String          @db.VarChar(64)
  ipAddress         String          @map("ip_address") @db.VarChar(45)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz

  cycle CleaningCycle? @relation(fields: [cycleId], references: [id])

  @@index([filterId, cycleId])
  @@index([performedAt])
  @@index([eventType, filterId])
  @@index([cycleId])
  @@index([filterId, cycleId, eventType])
  @@index([filterId, performedAt(sort: Desc)])
  @@map("filter_events")
}

// ─── Equipment Groups ──────────────────────────────────────

model EquipmentGroup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  blockId   String   @map("block_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  // Monotonic version counter — bumped on every mutation of the group OR any of
  // its 3 instruments. Snapshot-then-bump pattern (Phase A.4): the OUTGOING
  // composite (group + all instruments) is frozen into EquipmentGroupVersion
  // before the live rows are updated, so admin-edit history is preserved.
  // Note: cycles do NOT pin a group version — operational drift is already
  // covered by FilterEvent.attributes.instrumentReadings (immutable snapshot
  // of description / instrumentCode / uom / leastCount / value at submit time).
  version   Int      @default(1)
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  block       AssetInstance              @relation(fields: [blockId], references: [id])
  instruments EquipmentGroupInstrument[]
  cycles      CleaningCycle[]
  versions    EquipmentGroupVersion[]

  @@index([blockId])
  @@index([isActive])
  @@map("equipment_groups")
}

// Immutable historical snapshot of an EquipmentGroup at a specific version.
// Written BEFORE every mutation to the live group or any of its instruments
// (snapshot-then-bump, Phase A.4). The composite (group + 3 instruments) is
// always snapshotted together because update() mutates them as a unit.
model EquipmentGroupVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId       String   @map("group_id") @db.Uuid
  versionNumber Int      @map("version_number")
  // Full snapshot: { name, blockId, isActive, instruments: [{...full
  // EquipmentGroupInstrument shape, ordered by sortOrder...}] }
  snapshot      Json     @db.JsonB
  changeNotes   String?  @map("change_notes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String?  @map("created_by") @db.Uuid

  group EquipmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, versionNumber])
  @@index([groupId])
  @@map("equipment_group_versions")
}

model EquipmentGroupInstrument {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId       String   @map("group_id") @db.Uuid
  description   String   @db.VarChar(255) // "Compressed Air Pressure", "RO Water Pressure", "Dryer Temperature"
  stageKey      String   @map("stage_key") @db.VarChar(100) // "WASH_IN" or "DRY_IN"
  serialNumber  String   @map("serial_number") @db.VarChar(100)
  instrumentId  String   @map("instrument_id") @db.VarChar(100)
  uom           String   @db.VarChar(50)
  instrumentMin Float    @map("instrument_min")
  instrumentMax Float    @map("instrument_max")
  operatingMin  Float    @map("operating_min")
  operatingMax  Float    @map("operating_max")
  leastCount    Float    @map("least_count")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  group EquipmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
  @@map("equipment_group_instruments")
}

// ─── Checklist Profiles & Questions ──────────────────────────

enum ChecklistQuestionType {
  YES_NO
  PASS_FAIL
  YES_NO_NA
  TEXT
  NUMERIC
  DROPDOWN
  MULTI_SELECT
  DATE_TIME
  PHOTO
  SIGNATURE
  CALCULATED
  CONDITIONAL

  @@map("checklist_question_type")
}

model ChecklistProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  // Monotonic version counter — bumped on every mutation of profile or its questions.
  // Cycles pin the version at start so answers always resolve against the schema
  // the operator actually saw, even if the live profile is edited later (Phase A.1).
  version     Int      @default(1)
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  questions ChecklistQuestion[]
  versions  ChecklistProfileVersion[]

  @@index([isActive])
  @@map("checklist_profiles")
}

model ChecklistQuestion {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId    String                @map("profile_id") @db.Uuid
  question     String
  questionType ChecklistQuestionType @default(YES_NO) @map("question_type")
  required     Boolean               @default(false)
  section      String?               @db.VarChar(255)
  description  String?
  options      Json                  @default("[]") @db.JsonB
  validation   Json                  @default("{}") @db.JsonB
  sortOrder    Int                   @default(0) @map("sort_order")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  profile ChecklistProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
  @@map("checklist_questions")
}

// Immutable historical snapshot of a checklist profile at a specific version.
// Created BEFORE every mutation to the live profile or its questions (snapshot-then-bump).
// Cycles store a pin map { profileId: versionNumber } and resolve questions through here
// so answers always reproduce against the schema that was active when the cycle started.
model ChecklistProfileVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId     String   @map("profile_id") @db.Uuid
  versionNumber Int      @map("version_number")
  // Full snapshot: { name, description, isActive, questions: [...full ChecklistQuestion shape...] }
  snapshot      Json     @db.JsonB
  changeNotes   String?  @map("change_notes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String?  @map("created_by") @db.Uuid

  profile ChecklistProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, versionNumber])
  @@index([profileId])
  @@map("checklist_profile_versions")
}

enum BlockChangeStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@map("block_change_status")
}

model BlockChangeRequest {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filterId         String            @map("filter_id") @db.Uuid
  filterName       String            @map("filter_name") @db.VarChar(255)
  fromBlockId      String            @map("from_block_id") @db.Uuid
  fromBlockName    String            @map("from_block_name") @db.VarChar(255)
  toBlockId        String            @map("to_block_id") @db.Uuid
  toBlockName      String            @map("to_block_name") @db.VarChar(255)
  reason           String?
  status           BlockChangeStatus @default(PENDING)
  requestedBy      String            @map("requested_by") @db.Uuid
  requestedByName  String            @map("requested_by_name") @db.VarChar(255)
  processedBy      String?           @map("processed_by") @db.Uuid
  processedByName  String?           @map("processed_by_name") @db.VarChar(255)
  processedComment String?           @map("processed_comment")
  processedAt      DateTime?         @map("processed_at") @db.Timestamptz
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@index([filterId, toBlockId, status])
  @@index([status])
  @@index([requestedBy])
  @@map("block_change_requests")
}

// ─── Report Template Status ────────────────────────────────

enum ReportTemplateStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

enum ReportStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  REJECTED
  EXPIRED
}

// ─── Report Templates ──────────────────────────────────────

model ReportTemplate {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String               @db.VarChar(200)
  description    String?              @db.VarChar(2000)
  status         ReportTemplateStatus @default(ACTIVE)
  currentVersion Int                  @default(1) @map("current_version")
  createdBy      String               @map("created_by") @db.Uuid
  creator        User                 @relation("ReportTemplateCreator", fields: [createdBy], references: [id])
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  versions        ReportTemplateVersion[]
  reportInstances ReportInstance[]

  @@index([status])
  @@map("report_templates")
}

model ReportTemplateVersion {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String         @map("template_id") @db.Uuid
  template   ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version    Int
  config     Json           @db.JsonB
  changelog  String?
  createdBy  String         @map("created_by") @db.Uuid
  creator    User           @relation("TemplateVersionCreator", fields: [createdBy], references: [id])
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@unique([templateId, version])
  @@index([templateId])
  @@map("report_template_versions")
}

// ─── Report Instances ──────────────────────────────────────

model ReportInstance {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId      String         @map("template_id") @db.Uuid
  template        ReportTemplate @relation(fields: [templateId], references: [id])
  templateVersion Int            @map("template_version")
  name            String         @db.VarChar(500)
  status          ReportStatus   @default(DRAFT)
  timeRangeStart  DateTime?      @map("time_range_start") @db.Timestamptz
  timeRangeEnd    DateTime?      @map("time_range_end") @db.Timestamptz
  entitySlots     Json?          @map("entity_slots") @db.JsonB
  resolvedData    Json?          @map("resolved_data") @db.JsonB
  pdfPath         String?        @map("pdf_path") @db.VarChar(1000)
  pdfSize         Int?           @map("pdf_size")
  pageCount       Int?           @map("page_count")
  generatedBy     String         @map("generated_by") @db.Uuid
  generator       User           @relation("ReportGenerator", fields: [generatedBy], references: [id])
  generatedAt     DateTime       @default(now()) @map("generated_at") @db.Timestamptz
  signedAt        DateTime?      @map("signed_at") @db.Timestamptz
  expiresAt       DateTime?      @map("expires_at") @db.Timestamptz

  signatures ReportSignature[]

  @@index([templateId])
  @@index([status])
  @@index([generatedAt])
  @@map("report_instances")
}

model ReportSignature {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId    String         @map("report_id") @db.Uuid
  report      ReportInstance @relation(fields: [reportId], references: [id], onDelete: Cascade)
  signerRole  String         @map("signer_role") @db.VarChar(50)
  signerLabel String         @map("signer_label") @db.VarChar(100)
  userId      String         @map("user_id") @db.Uuid
  user        User           @relation("ReportSigner", fields: [userId], references: [id])
  meaning     String         @db.VarChar(500)
  signedAt    DateTime       @default(now()) @map("signed_at") @db.Timestamptz
  ipAddress   String?        @map("ip_address") @db.VarChar(45)
  userAgent   String?        @map("user_agent") @db.VarChar(500)

  @@unique([reportId, signerRole])
  @@index([reportId])
  @@index([userId])
  @@map("report_signatures")
}
