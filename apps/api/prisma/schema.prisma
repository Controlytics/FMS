generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Dynamic Role model - allows Super Admin to add/manage roles
model Role {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @unique @db.VarChar(50)      // e.g., "SUPER_ADMIN", "ADMIN"
  displayName     String   @map("display_name") @db.VarChar(100)  // e.g., "Super Admin", "Admin"
  description     String?  @db.VarChar(500)
  hierarchyLevel  Int      @map("hierarchy_level")      // Higher = more privileges (6 for SUPER_ADMIN)
  permissions     Json     @default("[]") @db.JsonB     // Array of permission strings
  color           String   @default("#6366f1") @db.VarChar(100)   // Badge color for UI (CSS class)
  isSystem        Boolean  @default(false) @map("is_system")     // System roles cannot be deleted
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy       String?  @map("created_by") @db.VarChar(50)
  updatedBy       String?  @map("updated_by") @db.VarChar(50)

  @@index([hierarchyLevel])
  @@index([isActive])
  @@map("roles")
}

enum UserStatus {
  ENABLED
  DISABLED
  LOCKED
  EXPIRED
}

model User {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username             String      @unique @db.VarChar(50)
  fullName             String      @map("full_name") @db.VarChar(100)
  email                String      @unique @db.VarChar(100)
  passwordHash         String      @map("password_hash")
  department           String?     @db.VarChar(50)
  photoUrl             String?     @map("photo_url") @db.VarChar(500)
  role                 String      @db.VarChar(50)  // References roles.name
  status               UserStatus  @default(ENABLED)
  failedLoginAttempts  Int         @default(0) @map("failed_login_attempts")
  lockedAt             DateTime?   @map("locked_at") @db.Timestamptz
  lockoutUntil         DateTime?   @map("lockout_until") @db.Timestamptz
  passwordChangedAt    DateTime?   @map("password_changed_at") @db.Timestamptz
  passwordExpiresAt    DateTime?   @map("password_expires_at") @db.Timestamptz
  forcePasswordChange  Boolean     @default(true) @map("force_password_change")
  isTemporaryPassword  Boolean     @default(true) @map("is_temporary_password")
  lastLogin            DateTime?   @map("last_login") @db.Timestamptz
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  createdBy            String?     @map("created_by") @db.VarChar(50)
  updatedBy            String?     @map("updated_by") @db.VarChar(50)

  passwordHistory      PasswordHistory[]
  sessions             Session[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model PasswordHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_history")
}

model Session {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @map("token_hash")
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  userAgent     String?   @map("user_agent")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastActiveAt  DateTime  @default(now()) @map("last_active_at") @db.Timestamptz
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  terminationReason String? @map("termination_reason") @db.VarChar(50)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@map("sessions")
}

model SystemConfig {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configKey    String   @unique @map("config_key") @db.VarChar(100)
  configValue  Json     @map("config_value")
  configType   String   @map("config_type") @db.VarChar(50)
  requiresReauth Boolean @default(false) @map("requires_reauth")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy    String?  @map("updated_by") @db.VarChar(50)

  @@map("system_config")
}

model FieldIdConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fieldId     String   @unique @map("field_id") @db.VarChar(50)
  defaultName String   @map("default_name") @db.VarChar(100)
  displayName String   @map("display_name") @db.VarChar(100)
  module      String   @db.VarChar(50)
  description String?
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy   String?  @map("updated_by") @db.VarChar(50)

  @@map("field_id_config")
}

model PasswordResetRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.VarChar(50)
  status       String    @default("PENDING") @db.VarChar(20)
  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  processedAt  DateTime? @map("processed_at") @db.Timestamptz
  processedBy  String?   @map("processed_by") @db.VarChar(50)
  notes        String?

  @@map("password_reset_requests")
}

model AuditTrail {
  id            Int       @id @default(autoincrement())
  timestamp     DateTime  @default(now()) @db.Timestamptz
  userId        String?   @map("user_id") @db.VarChar(100)
  userName      String?   @map("user_name") @db.VarChar(100)
  userRole      String?   @map("user_role") @db.VarChar(20)
  action        String    @db.VarChar(100)
  targetType    String?   @map("target_type") @db.VarChar(50)
  targetId      String?   @map("target_id") @db.VarChar(255)
  beforeValue   Json?     @map("before_value")
  afterValue    Json?     @map("after_value")
  reason        String?
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  userAgent     String?   @map("user_agent")
  sessionId     String?   @map("session_id") @db.VarChar(100)
  checksum          String    @db.VarChar(64)
  signatureMeaning  String?   @map("signature_meaning") @db.VarChar(255)

  @@index([timestamp(sort: Desc)])
  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([sessionId])
  @@map("audit_trail")
}

// ============================================================
// ASSET MODULE — Templates, Instances, Checklists, Schedules, Alarms
// ============================================================

// Asset Template — reusable blueprint for asset types
model AssetTemplate {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String   @unique @db.VarChar(255)
  description           String?
  icon                  String?  @db.VarChar(50)
  category              String?  @db.VarChar(100)
  attributeSchema       Json     @default("[]") @map("attribute_schema") @db.JsonB
  telemetrySchema       Json     @default("[]") @map("telemetry_schema") @db.JsonB
  checklistSchema       Json     @default("[]") @map("checklist_schema") @db.JsonB
  recordListSchema      Json     @default("[]") @map("record_list_schema") @db.JsonB
  expectedRelationships Json     @default("[]") @map("expected_relationships") @db.JsonB
  expectedIdentifiers   Json     @default("[]") @map("expected_identifiers") @db.JsonB
  defaultAlarmRules     Json     @default("[]") @map("default_alarm_rules") @db.JsonB
  statusLifecycle       Json     @default("[]") @map("status_lifecycle") @db.JsonB
  version               Int      @default(1)
  status                String   @default("draft") @db.VarChar(20) // draft, active, inactive
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy             String?  @map("created_by") @db.Uuid
  updatedBy             String?  @map("updated_by") @db.Uuid

  templateVersions TemplateVersion[]
  assetInstances   AssetInstance[]

  @@index([status])
  @@index([category])
  @@map("asset_templates")
}

// Template Version — tracks every change to a template
model TemplateVersion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  version    Int
  snapshot   Json     @db.JsonB
  changeLog  String   @map("change_log")
  changedBy  String   @map("changed_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  template AssetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, version])
  @@map("template_versions")
}

// Asset Instance — actual asset created from a template
model AssetInstance {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @db.VarChar(255)
  description     String?
  templateId      String   @map("template_id") @db.Uuid
  templateVersion Int      @map("template_version")
  unsPath         String   @default("") @map("uns_path") @db.VarChar(1000)
  status          String   @default("Active") @db.VarChar(50) // Active, Inactive, Under_Maintenance, Commissioning, Decommissioned
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid

  template            AssetTemplate        @relation(fields: [templateId], references: [id])
  attributes          AssetAttribute[]
  telemetryPoints     TelemetryPoint[]
  sourceRelationships AssetRelationship[]  @relation("RelSource")
  targetRelationships AssetRelationship[]  @relation("RelTarget")
  identifiers         PhysicalIdentifier[]
  checklists          ChecklistTemplate[]
  records             ChecklistRecord[]
  schedules           AssetSchedule[]
  alarmRules          AlarmRule[]
  alarmEvents         AlarmEvent[]

  @@index([templateId])
  @@index([status])
  @@index([unsPath])
  @@map("asset_instances")
}

// Asset Attribute — normalized attribute with per-field audit history
model AssetAttribute {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId            String   @map("asset_id") @db.Uuid
  name               String   @db.VarChar(255)
  dataType           String   @map("data_type") @db.VarChar(20) // TEXT, INTEGER, FLOAT, DATE, DATETIME, BOOLEAN, DROPDOWN, URL, FILE
  value              Json?    @db.JsonB
  unit               String?  @db.VarChar(50)
  isRequired         Boolean  @default(false) @map("is_required")
  isCustom           Boolean  @default(false) @map("is_custom")
  numericConstraints Json?    @map("numeric_constraints") @db.JsonB // {min, max, resolution, enableConstraints}
  dropdownOptions    Json?    @map("dropdown_options") @db.JsonB    // string array
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy          String?  @map("updated_by") @db.Uuid

  asset   AssetInstance          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  history AssetAttributeHistory[]

  @@unique([assetId, name])
  @@index([assetId])
  @@map("asset_attributes")
}

// Asset Attribute History — before/after on every attribute change
model AssetAttributeHistory {
  id            Int      @id @default(autoincrement())
  attributeId   String   @map("attribute_id") @db.Uuid
  assetId       String   @map("asset_id") @db.Uuid
  previousValue Json?    @map("previous_value") @db.JsonB
  newValue      Json     @map("new_value") @db.JsonB
  changedBy     String   @map("changed_by") @db.VarChar(100)
  reason        String
  changedAt     DateTime @default(now()) @map("changed_at") @db.Timestamptz

  attribute AssetAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@index([attributeId, changedAt(sort: Desc)])
  @@index([assetId])
  @@map("asset_attribute_history")
}

// Telemetry Point — config for each data stream on an asset
model TelemetryPoint {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId            String   @map("asset_id") @db.Uuid
  name               String   @db.VarChar(255)
  dataType           String   @map("data_type") @db.VarChar(20) // INTEGER, FLOAT, BOOLEAN, STRING, ENUM
  unit               String?  @db.VarChar(50)
  isCustom           Boolean  @default(false) @map("is_custom")
  numericConstraints Json?    @map("numeric_constraints") @db.JsonB
  enumOptions        Json?    @map("enum_options") @db.JsonB
  alarmLimits        Json?    @map("alarm_limits") @db.JsonB // {high, low, highHigh, lowLow, rateOfChange, deadband}
  dataSource         String   @default("MANUAL") @map("data_source") @db.VarChar(20) // MANUAL, AUTOMATIC, BOTH
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  asset    AssetInstance      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  readings TelemetryReading[]

  @@unique([assetId, name])
  @@index([assetId])
  @@map("telemetry_points")
}

// Telemetry Reading — time-series data (immutable once recorded)
model TelemetryReading {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telemetryPointId  String   @map("telemetry_point_id") @db.Uuid
  assetId           String   @map("asset_id") @db.Uuid
  value             Json     @db.JsonB
  timestamp         DateTime @db.Timestamptz
  source            String   @db.VarChar(20) // manual, mqtt, api, checklist
  isCorrection      Boolean  @default(false) @map("is_correction")
  correctionReason  String?  @map("correction_reason")
  correctionOf      String?  @map("correction_of") @db.Uuid
  isRejected        Boolean  @default(false) @map("is_rejected")
  rejectionReason   String?  @map("rejection_reason")
  recordedBy        String?  @map("recorded_by") @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  telemetryPoint TelemetryPoint @relation(fields: [telemetryPointId], references: [id], onDelete: Cascade)

  @@index([telemetryPointId, timestamp(sort: Desc)])
  @@index([assetId, timestamp(sort: Desc)])
  @@map("telemetry_readings")
}

// Asset Relationship — bidirectional links between assets
model AssetRelationship {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceAssetId      String   @map("source_asset_id") @db.Uuid
  targetAssetId      String   @map("target_asset_id") @db.Uuid
  relationshipType   String   @map("relationship_type") @db.VarChar(50) // CONTAINS, CONNECTED_TO, FEEDS, DEPENDS_ON, BACKS_UP, MONITORS, CUSTOM
  customLabel        String?  @map("custom_label") @db.VarChar(100)
  customInverseLabel String?  @map("custom_inverse_label") @db.VarChar(100)
  isPrimary          Boolean  @default(false) @map("is_primary") // primary containment for UNS path
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy          String?  @map("created_by") @db.VarChar(100)

  sourceAsset AssetInstance @relation("RelSource", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  targetAsset AssetInstance @relation("RelTarget", fields: [targetAssetId], references: [id], onDelete: Cascade)

  @@unique([sourceAssetId, targetAssetId, relationshipType])
  @@index([sourceAssetId])
  @@index([targetAssetId])
  @@map("asset_relationships")
}

// Physical Identifier — QR, Barcode, RFID, NFC, Manual
model PhysicalIdentifier {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  type      String   @db.VarChar(20) // QR, BARCODE, RFID, NFC, MANUAL
  value     String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  asset AssetInstance @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@index([assetId])
  @@map("physical_identifiers")
}

// Checklist Template — per-asset checklist definition
model ChecklistTemplate {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId           String   @map("asset_id") @db.Uuid
  name              String   @db.VarChar(255)
  description       String?
  checklistType     String   @default("CHECKLIST") @map("checklist_type") @db.VarChar(20) // CHECKLIST, RECORD_LIST
  questions         Json     @default("[]") @db.JsonB
  performedByRole   String?  @map("performed_by_role") @db.VarChar(50)
  checkedByEnabled  Boolean  @default(false) @map("checked_by_enabled")
  checkedByRole     String?  @map("checked_by_role") @db.VarChar(50)
  verifiedByEnabled Boolean  @default(false) @map("verified_by_enabled")
  verifiedByRole    String?  @map("verified_by_role") @db.VarChar(50)
  isFromTemplate    Boolean  @default(true) @map("is_from_template")
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy         String?  @map("created_by") @db.Uuid

  asset     AssetInstance     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  records   ChecklistRecord[]
  schedules AssetSchedule[]

  @@index([assetId])
  @@map("checklist_templates")
}

// Checklist Record — immutable completed checklist with 3-tier sign-off
model ChecklistRecord {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checklistTemplateId  String   @map("checklist_template_id") @db.Uuid
  assetId              String   @map("asset_id") @db.Uuid
  scheduleId           String?  @map("schedule_id") @db.Uuid
  responses            Json     @default("[]") @db.JsonB
  status               String   @default("IN_PROGRESS") @db.VarChar(30) // IN_PROGRESS, PENDING_CHECK, PENDING_VERIFICATION, COMPLETED, REJECTED
  // Performed By (Tier 1 — always required)
  performedBy          String?  @map("performed_by") @db.VarChar(100)
  performedAt          DateTime? @map("performed_at") @db.Timestamptz
  performedSignature   String?  @map("performed_signature") @db.VarChar(255)
  // Checked By (Tier 2 — optional)
  checkedBy            String?  @map("checked_by") @db.VarChar(100)
  checkedAt            DateTime? @map("checked_at") @db.Timestamptz
  checkedSignature     String?  @map("checked_signature") @db.VarChar(255)
  checkedComments      String?  @map("checked_comments")
  // Verified By (Tier 3 — optional)
  verifiedBy           String?  @map("verified_by") @db.VarChar(100)
  verifiedAt           DateTime? @map("verified_at") @db.Timestamptz
  verifiedSignature    String?  @map("verified_signature") @db.VarChar(255)
  verifiedComments     String?  @map("verified_comments")
  // Compliance & integrity
  scheduleCompliance   String?  @map("schedule_compliance") @db.VarChar(20) // ON_TIME, EARLY, LATE, MISSED, AD_HOC
  checksum             String?  @db.VarChar(64)
  unsPath              String?  @map("uns_path") @db.VarChar(1000)
  // Corrections
  isCorrection         Boolean  @default(false) @map("is_correction")
  correctionOf         String?  @map("correction_of") @db.Uuid
  correctionReason     String?  @map("correction_reason")
  // Device/provenance
  deviceInfo           Json?    @map("device_info") @db.JsonB
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  checklistTemplate ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id])
  asset             AssetInstance     @relation(fields: [assetId], references: [id])
  schedule          AssetSchedule?    @relation(fields: [scheduleId], references: [id])

  @@index([assetId, createdAt(sort: Desc)])
  @@index([checklistTemplateId])
  @@index([status])
  @@map("checklist_records")
}

// Asset Schedule — recurring task frequency and tolerance
model AssetSchedule {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId             String    @map("asset_id") @db.Uuid
  checklistTemplateId String    @map("checklist_template_id") @db.Uuid
  frequency           String    @db.VarChar(20) // HOURLY, PER_SHIFT, DAILY, WEEKLY, MONTHLY, QUARTERLY, ANNUALLY, CUSTOM
  frequencyValue      Int?      @map("frequency_value")
  cronExpression      String?   @map("cron_expression") @db.VarChar(100)
  toleranceMinutes    Int       @default(0) @map("tolerance_minutes")
  lastPerformedAt     DateTime? @map("last_performed_at") @db.Timestamptz
  nextDueAt           DateTime? @map("next_due_at") @db.Timestamptz
  isOnboarding        Boolean   @default(false) @map("is_onboarding")
  status              String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, PAUSED, COMPLETED
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdBy           String?   @map("created_by") @db.Uuid

  asset             AssetInstance     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  checklistTemplate ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id])
  records           ChecklistRecord[]

  @@index([assetId])
  @@index([nextDueAt])
  @@index([status])
  @@map("asset_schedules")
}

// Alarm Rule — threshold-based or custom logic alarm configuration
model AlarmRule {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId             String   @map("asset_id") @db.Uuid
  name                String   @db.VarChar(255)
  ruleType            String   @map("rule_type") @db.VarChar(30) // TELEMETRY_THRESHOLD, CHECKLIST_LOGIC, SCHEDULE_MISSED, CUSTOM_SCRIPT
  telemetryPointId    String?  @map("telemetry_point_id") @db.Uuid
  checklistTemplateId String?  @map("checklist_template_id") @db.Uuid
  condition           Json     @db.JsonB
  severity            String   @db.VarChar(20) // INFO, WARNING, CRITICAL
  actions             Json     @default("[]") @db.JsonB
  isActive            Boolean  @default(true) @map("is_active")
  isFromTemplate      Boolean  @default(true) @map("is_from_template")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy           String?  @map("created_by") @db.Uuid

  asset  AssetInstance @relation(fields: [assetId], references: [id], onDelete: Cascade)
  events AlarmEvent[]

  @@index([assetId])
  @@map("alarm_rules")
}

// Alarm Event — triggered alarm instance with lifecycle
model AlarmEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alarmRuleId    String    @map("alarm_rule_id") @db.Uuid
  assetId        String    @map("asset_id") @db.Uuid
  triggeredValue Json      @map("triggered_value") @db.JsonB
  severity       String    @db.VarChar(20) // INFO, WARNING, CRITICAL
  status         String    @default("OPEN") @db.VarChar(20) // OPEN, ACKNOWLEDGED, CLOSED
  message        String?   @db.VarChar(1000)
  acknowledgedBy String?   @map("acknowledged_by") @db.VarChar(100)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz
  closedBy       String?   @map("closed_by") @db.VarChar(100)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz
  closedReason   String?   @map("closed_reason")
  metadata       Json?     @db.JsonB
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  alarmRule AlarmRule     @relation(fields: [alarmRuleId], references: [id])
  asset     AssetInstance @relation(fields: [assetId], references: [id])

  @@index([assetId, createdAt(sort: Desc)])
  @@index([status])
  @@map("alarm_events")
}

// Notification types for user alerts
enum NotificationType {
  ACCOUNT_LOCKED
  ACCOUNT_DISABLED
  ACCOUNT_ENABLED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_APPROVED
  PASSWORD_RESET_REJECTED
  USER_CREATED
  USER_UPDATED
  ROLE_CHANGED
  // Asset module notifications
  CHECKLIST_PENDING_CHECK
  CHECKLIST_PENDING_VERIFICATION
  CHECKLIST_REJECTED
  ALARM_TRIGGERED
  SCHEDULE_OVERDUE
  ASSET_DECOMMISSIONED
}

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(200)
  message     String           @db.VarChar(1000)
  targetUserId String?         @map("target_user_id") @db.VarChar(50) // The user this notification is about
  forUserId    String?         @map("for_user_id") @db.VarChar(50)    // The user who should see this (null = admins)
  forRole      String?         @map("for_role") @db.VarChar(50)       // Role that should see this notification
  isRead       Boolean         @default(false) @map("is_read")
  readAt       DateTime?       @map("read_at") @db.Timestamptz
  metadata     Json?           @db.JsonB                              // Additional context data
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?         @map("created_by") @db.VarChar(50)

  @@index([forUserId])
  @@index([forRole])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

// User-specific sidebar and feature configuration
model UserConfig {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  sidebarItems    Json     @default("[]") @map("sidebar_items") @db.JsonB  // Array of enabled sidebar items
  homeWidgets     Json     @default("[]") @map("home_widgets") @db.JsonB   // Array of enabled home widgets
  permissions     Json     @default("{}") @map("permissions") @db.JsonB    // Feature-level permissions
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy       String?  @map("updated_by") @db.VarChar(50)

  @@map("user_configs")
}

// Role-based default configuration
model RoleConfig {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role            String   @unique @db.VarChar(50)  // References roles.name
  sidebarItems    Json     @default("[]") @map("sidebar_items") @db.JsonB
  homeWidgets     Json     @default("[]") @map("home_widgets") @db.JsonB
  permissions     Json     @default("{}") @map("permissions") @db.JsonB
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy       String?  @map("updated_by") @db.VarChar(50)

  @@map("role_configs")
}
