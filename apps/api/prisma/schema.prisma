generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Dynamic Role model - allows Super Admin to add/manage roles
model Role {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @unique @db.VarChar(50)      // e.g., "SUPER_ADMIN", "ADMIN"
  displayName     String   @map("display_name") @db.VarChar(100)  // e.g., "Super Admin", "Admin"
  description     String?  @db.VarChar(500)
  hierarchyLevel  Int      @map("hierarchy_level")      // Higher = more privileges (6 for SUPER_ADMIN)
  permissions     Json     @default("[]") @db.JsonB     // Array of permission strings
  color           String   @default("#6366f1") @db.VarChar(100)   // Badge color for UI (CSS class)
  isSystem        Boolean  @default(false) @map("is_system")     // System roles cannot be deleted
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy       String?  @map("created_by") @db.VarChar(50)
  updatedBy       String?  @map("updated_by") @db.VarChar(50)

  @@index([hierarchyLevel])
  @@index([isActive])
  @@map("roles")
}

enum UserStatus {
  ENABLED
  DISABLED
  LOCKED
  EXPIRED
}

model User {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username             String      @unique @db.VarChar(50)
  fullName             String      @map("full_name") @db.VarChar(100)
  email                String      @unique @db.VarChar(100)
  passwordHash         String      @map("password_hash")
  department           String?     @db.VarChar(50)
  photoUrl             String?     @map("photo_url") @db.VarChar(500)
  role                 String      @db.VarChar(50)  // References roles.name
  status               UserStatus  @default(ENABLED)
  failedLoginAttempts  Int         @default(0) @map("failed_login_attempts")
  lockedAt             DateTime?   @map("locked_at") @db.Timestamptz
  lockoutUntil         DateTime?   @map("lockout_until") @db.Timestamptz
  passwordChangedAt    DateTime?   @map("password_changed_at") @db.Timestamptz
  passwordExpiresAt    DateTime?   @map("password_expires_at") @db.Timestamptz
  forcePasswordChange  Boolean     @default(true) @map("force_password_change")
  isTemporaryPassword  Boolean     @default(true) @map("is_temporary_password")
  lastLogin            DateTime?   @map("last_login") @db.Timestamptz
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  createdBy            String?     @map("created_by") @db.VarChar(50)
  updatedBy            String?     @map("updated_by") @db.VarChar(50)

  passwordHistory      PasswordHistory[]
  sessions             Session[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model PasswordHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_history")
}

model Session {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @map("token_hash")
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  userAgent     String?   @map("user_agent")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastActiveAt  DateTime  @default(now()) @map("last_active_at") @db.Timestamptz
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  terminationReason String? @map("termination_reason") @db.VarChar(50)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@map("sessions")
}

model SystemConfig {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configKey    String   @unique @map("config_key") @db.VarChar(100)
  configValue  Json     @map("config_value")
  configType   String   @map("config_type") @db.VarChar(50)
  requiresReauth Boolean @default(false) @map("requires_reauth")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy    String?  @map("updated_by") @db.VarChar(50)

  @@map("system_config")
}

model FieldIdConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fieldId     String   @unique @map("field_id") @db.VarChar(50)
  defaultName String   @map("default_name") @db.VarChar(100)
  displayName String   @map("display_name") @db.VarChar(100)
  module      String   @db.VarChar(50)
  description String?
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy   String?  @map("updated_by") @db.VarChar(50)

  @@map("field_id_config")
}

model PasswordResetRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.VarChar(50)
  status       String    @default("PENDING") @db.VarChar(20)
  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  processedAt  DateTime? @map("processed_at") @db.Timestamptz
  processedBy  String?   @map("processed_by") @db.VarChar(50)
  notes        String?

  @@map("password_reset_requests")
}

model AuditTrail {
  id            Int       @id @default(autoincrement())
  timestamp     DateTime  @default(now()) @db.Timestamptz
  userId        String?   @map("user_id") @db.VarChar(100)
  userName      String?   @map("user_name") @db.VarChar(100)
  userRole      String?   @map("user_role") @db.VarChar(20)
  action        String    @db.VarChar(100)
  targetType    String?   @map("target_type") @db.VarChar(50)
  targetId      String?   @map("target_id") @db.VarChar(255)
  beforeValue   Json?     @map("before_value")
  afterValue    Json?     @map("after_value")
  reason        String?
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  userAgent     String?   @map("user_agent")
  sessionId     String?   @map("session_id") @db.VarChar(100)
  checksum          String    @db.VarChar(64)
  signatureMeaning  String?   @map("signature_meaning") @db.VarChar(255)

  @@index([timestamp(sort: Desc)])
  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([sessionId])
  @@map("audit_trail")
}

// Notification types for user alerts
enum NotificationType {
  ACCOUNT_LOCKED
  ACCOUNT_DISABLED
  ACCOUNT_ENABLED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_APPROVED
  PASSWORD_RESET_REJECTED
  USER_CREATED
  USER_UPDATED
  ROLE_CHANGED
}

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(200)
  message     String           @db.VarChar(1000)
  targetUserId String?         @map("target_user_id") @db.VarChar(50) // The user this notification is about
  forUserId    String?         @map("for_user_id") @db.VarChar(50)    // The user who should see this (null = admins)
  forRole      String?         @map("for_role") @db.VarChar(50)       // Role that should see this notification
  isRead       Boolean         @default(false) @map("is_read")
  readAt       DateTime?       @map("read_at") @db.Timestamptz
  metadata     Json?           @db.JsonB                              // Additional context data
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?         @map("created_by") @db.VarChar(50)

  @@index([forUserId])
  @@index([forRole])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

// User-specific sidebar and feature configuration
model UserConfig {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  sidebarItems    Json     @default("[]") @map("sidebar_items") @db.JsonB  // Array of enabled sidebar items
  homeWidgets     Json     @default("[]") @map("home_widgets") @db.JsonB   // Array of enabled home widgets
  permissions     Json     @default("{}") @map("permissions") @db.JsonB    // Feature-level permissions
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy       String?  @map("updated_by") @db.VarChar(50)

  @@map("user_configs")
}

// Role-based default configuration
model RoleConfig {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role            String   @unique @db.VarChar(50)  // References roles.name
  sidebarItems    Json     @default("[]") @map("sidebar_items") @db.JsonB
  homeWidgets     Json     @default("[]") @map("home_widgets") @db.JsonB
  permissions     Json     @default("{}") @map("permissions") @db.JsonB
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy       String?  @map("updated_by") @db.VarChar(50)

  @@map("role_configs")
}

// =============================================
// ASSET MANAGEMENT MODELS
// =============================================

// Asset Template — reusable blueprint for asset types
model AssetTemplate {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String   @unique @db.VarChar(100)
  description           String?  @db.VarChar(500)
  category              String   @default("General") @db.VarChar(50)  // Equipment, Room, Building, etc.
  icon                  String   @default("box") @db.VarChar(50)      // Icon identifier for UI
  version               Int      @default(1)                          // Current version number
  attributeSchema       Json     @default("[]") @map("attribute_schema") @db.JsonB   // Array of attribute definitions
  telemetrySchema       Json     @default("[]") @map("telemetry_schema") @db.JsonB   // Array of telemetry point definitions
  expectedIdentifiers   Json     @default("[]") @map("expected_identifiers") @db.JsonB // Array of expected identifier types
  expectedRelationships Json     @default("[]") @map("expected_relationships") @db.JsonB // Array of expected relationship types
  statusLifecycle       Json     @default("[]") @map("status_lifecycle") @db.JsonB    // Array of status definitions with transitions
  alarmRules            Json     @default("[]") @map("alarm_rules") @db.JsonB       // Array of alarm rule definitions (threshold + custom logic)
  maxParentConnections  Int      @default(1) @map("max_parent_connections")         // Max CONTAINS parents: 0=none, 1+=limit
  maxConnections        Int      @default(10) @map("max_connections")               // Max total connections (all types): 0=unlimited, N=limit
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy             String?  @map("created_by") @db.VarChar(50)
  updatedBy             String?  @map("updated_by") @db.VarChar(50)

  versions  AssetTemplateVersion[]
  instances AssetInstance[]

  @@index([isActive])
  @@index([category])
  @@map("asset_templates")
}

// Asset Template Version — snapshot of template at a point in time
model AssetTemplateVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId    String   @map("template_id") @db.Uuid
  versionNumber Int      @map("version_number")
  snapshot      Json     @db.JsonB                        // Full template snapshot at time of version
  changeNotes   String?  @map("change_notes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String?  @map("created_by") @db.VarChar(50)

  template AssetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, versionNumber])
  @@index([templateId])
  @@map("asset_template_versions")
}

// Asset Instance — actual asset created from a template
model AssetInstance {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @db.VarChar(255)
  description      String?
  templateId       String   @map("template_id") @db.Uuid
  templateVersion  Int      @default(1) @map("template_version")   // Which version it was created from
  status           String   @default("Active") @db.VarChar(50)     // Active, Inactive, Under Maintenance, Decommissioned
  attributes       Json     @default("{}") @db.JsonB               // Key-value pairs with actual attribute values
  telemetryConfig  Json     @default("{}") @map("telemetry_config") @db.JsonB  // Instance-level telemetry overrides
  customAttributes Json     @default("{}") @map("custom_attributes") @db.JsonB // Extra attributes added at instance level
  parentId         String?  @map("parent_id") @db.Uuid             // Primary containment parent (for tree)
  unsPath          String?  @map("uns_path") @db.VarChar(500)      // Computed UNS path
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy        String?  @map("created_by") @db.VarChar(50)
  updatedBy        String?  @map("updated_by") @db.VarChar(50)

  template          AssetTemplate       @relation(fields: [templateId], references: [id])
  parent            AssetInstance?       @relation("AssetHierarchy", fields: [parentId], references: [id])
  children          AssetInstance[]      @relation("AssetHierarchy")
  sourceRelations   AssetRelationship[]  @relation("SourceAsset")
  targetRelations   AssetRelationship[]  @relation("TargetAsset")
  identifiers       AssetIdentifier[]

  @@index([templateId])
  @@index([status])
  @@index([parentId])
  @@index([name])
  @@index([isActive])
  @@map("asset_instances")
}

// Asset Relationship — bidirectional connections between assets
model AssetRelationship {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceAssetId    String   @map("source_asset_id") @db.Uuid
  targetAssetId    String   @map("target_asset_id") @db.Uuid
  relationshipType String   @map("relationship_type") @db.VarChar(50) // CONTAINS, CONTAINED_IN, CONNECTED_TO, etc.
  customLabel      String?  @map("custom_label") @db.VarChar(100)     // For CUSTOM type
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy        String?  @map("created_by") @db.VarChar(50)
  updatedBy        String?  @map("updated_by") @db.VarChar(50)

  sourceAsset AssetInstance @relation("SourceAsset", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  targetAsset AssetInstance @relation("TargetAsset", fields: [targetAssetId], references: [id], onDelete: Cascade)

  @@unique([sourceAssetId, targetAssetId, relationshipType])
  @@index([sourceAssetId])
  @@index([targetAssetId])
  @@index([relationshipType])
  @@map("asset_relationships")
}

// Asset Identifier — physical identifiers (QR, RFID, NFC, Barcode, Manual)
model AssetIdentifier {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId         String   @map("asset_id") @db.Uuid
  identifierType  String   @map("identifier_type") @db.VarChar(20)  // QR, BARCODE, RFID, NFC, MANUAL
  identifierValue String   @unique @map("identifier_value") @db.VarChar(255)
  label           String?  @db.VarChar(100)
  isPrimary       Boolean  @default(false) @map("is_primary")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy       String?  @map("created_by") @db.VarChar(50)
  updatedBy       String?  @map("updated_by") @db.VarChar(50)

  asset AssetInstance @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([identifierType])
  @@map("asset_identifiers")
}

