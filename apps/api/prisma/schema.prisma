// Device Credentials (per entity instance)
model DeviceCredential {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityId           String    @unique @map("entity_id") @db.Uuid
  accessToken        String    @unique @map("access_token")
  credentialData     Json?     @map("credential_data") @db.JsonB
  status             String    @default("INACTIVE") @db.VarChar(20) // INACTIVE | ACTIVE
  allowedIps         String[]  @default([]) @map("allowed_ips")
