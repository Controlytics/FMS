# Dependencies
node_modules/
apps/*/node_modules/

# Build outputs
dist/
apps/*/dist/
packages/*/dist/

# Turbo
.turbo/

# Environment files
.env
apps/*/.env

# IDE
.vscode/
.idea/

# Misc
*.log
.DS_Store
nul


# Sensitive files - NEVER track
.env.production
.env.staging
.env.*.local
CREDENTIALS.md
*.pem
*.key
.bak

# Playwright MCP session traces (regenerated each run)
.playwright-mcp/

# Mosquitto dynamic-security: contains bcrypt hashes after first
# /refresh-acl call, never commit. Use mosquitto/dynamic-security.json.example
# as the bootstrap (the installer copies it on first run).
mosquitto/dynamic-security.json
mosquitto/dynamic-security.json.tmp
