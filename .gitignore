# Dependencies
node_modules/
apps/*/node_modules/

# Build outputs
dist/
apps/*/dist/
packages/*/dist/

# Turbo
.turbo/

# Environment files
.env
apps/*/.env
apps/*/.env.backup-*

# IDE
.vscode/
.idea/

# Misc
*.log
.DS_Store
nul

# NSSM service runtime artifacts (per-machine; install-services-phase5.ps1
# pins the NSSM exe path here so subsequent runs find the same one).
nssm-path.txt
logs/


# Sensitive files - NEVER track
.env.production
.env.staging
.env.*.local
CREDENTIALS.md
*.pem
*.key
.bak

# Playwright MCP session traces (regenerated each run)
.playwright-mcp/

# Root-level test/QA screenshot droppings (bug-fix-*.png, bug-sweep-*.png,
# mt-removal-*.png, step1-*.png, step6-e2e-*.png, tour-*.png, etc.).
# Anchored to repo root with leading "/" — tracked PNGs in
# PROJECT_HANDOVER/diagrams/, apps/, RFID/, old/screenshots/ are unaffected.
/*.png

# Old/local backup snapshots (pg_dump outputs, etc.)
/backups/

# Mosquitto dynamic-security: contains bcrypt hashes after first
# /refresh-acl call, never commit. Use mosquitto/dynamic-security.json.example
# as the bootstrap (the installer copies it on first run).
mosquitto/dynamic-security.json
mosquitto/dynamic-security.json.tmp
